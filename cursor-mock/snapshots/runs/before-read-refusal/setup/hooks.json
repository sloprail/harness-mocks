{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": ".cursor/hooks/hook.sh" }],
    "preToolUse": [{ "command": ".cursor/hooks/hook.sh" }],
    "beforeReadFile": [{ "command": ".cursor/hooks/hook.sh" }, { "command": ".cursor/hooks/closed.sh", "failClosed": true }],
    "postToolUse": [{ "command": ".cursor/hooks/hook.sh" }],
    "postToolUseFailure": [{ "command": ".cursor/hooks/hook.sh" }]
  }
}
