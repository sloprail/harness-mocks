{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh block"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh halt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh stop"
          }
        ]
      }
    ]
  }
}
