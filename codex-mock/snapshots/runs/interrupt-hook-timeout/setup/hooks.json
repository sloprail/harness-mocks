{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh default 2"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh limit3 2",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh capped 5",
            "timeout": 10
          }
        ]
      }
    ]
  }
}