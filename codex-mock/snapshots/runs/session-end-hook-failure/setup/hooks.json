{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh exit1"},
          {"type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh exit2"},
          {"type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh slow", "timeout": 1},
          {"type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh async", "async": true}
        ]
      }
    ]
  }
}
