    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh" } ] }
    ]
  }
}
