{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh json"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh plain"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh exit2"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh none"
          }
        ]
      }
    ]
  }
}