{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh stop"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh block"
          }
        ]
      }
    ]
  }
}