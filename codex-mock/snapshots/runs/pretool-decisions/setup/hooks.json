{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh allow"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh deny"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/hook.sh ask"
          }
        ]
      }
    ]
  }
}
